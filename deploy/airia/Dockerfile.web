FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY apps/web/package*.json apps/web/
RUN npm ci

COPY apps/web apps/web

ARG VITE_API_URL=/api
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_APK_URL
ARG VITE_APP_RELEASE

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_APK_URL=$VITE_APK_URL
ENV VITE_APP_RELEASE=$VITE_APP_RELEASE

RUN cd apps/web && node ./node_modules/vite/bin/vite.js build

FROM nginx:1.27-alpine

ARG VITE_APP_RELEASE
LABEL org.opencontainers.image.revision=$VITE_APP_RELEASE

COPY deploy/airia/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
