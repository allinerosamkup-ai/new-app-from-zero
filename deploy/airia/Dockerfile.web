FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY apps/web/package*.json apps/web/
RUN npm ci

COPY apps/web apps/web

ARG VITE_API_URL=/api
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_APK_URL
ARG VITE_APP_RELEASE

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_APK_URL=$VITE_APK_URL
ENV VITE_APP_RELEASE=$VITE_APP_RELEASE

# `npm run build`, não o binário do Vite direto.
#
# Chamar o Vite por caminho pulava tudo que o script `build` faz além dele — foi
# assim que `index.en.html` saiu verde no build local e simplesmente não existiu
# na imagem, deixando `?lang=en` em 404 na produção. O script é a fonte da
# verdade do que compõe uma build publicável.
#
# O script invoca `node ./node_modules/vite/bin/vite.js` em vez de `vite`: aqui
# o atalho em `.bin` chega sem permissão de execução (`sh: vite: Permission
# denied`), e era essa a razão do comando antigo. O contorno continua, agora
# dentro do script, onde vale para todo mundo.
RUN npm run build --workspace=@app/web

FROM nginx:1.27-alpine

ARG VITE_APP_RELEASE
LABEL org.opencontainers.image.revision=$VITE_APP_RELEASE

COPY deploy/airia/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
