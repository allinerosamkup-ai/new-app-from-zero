# Copy to .env.backend and fill in production values.
PORT=3001
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
DIRECT_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_COMPLETION_TOKENS=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing. Real credentials belong only in the runtime .env.backend.
BILLING_PROVIDER=cakto
APP_URL=https://airia.pro
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=
CAKTO_SUBSCRIPTION_PRODUCT_ID=
CAKTO_LIFETIME_PRODUCT_ID=
CAKTO_MONTHLY_OFFER_ID=
CAKTO_ANNUAL_OFFER_ID=
CAKTO_LIFETIME_OFFER_ID=
CAKTO_API_BASE_URL=https://api.cakto.com.br
CAKTO_CHECKOUT_BASE_URL=https://pay.cakto.com.br

# Explicit contingency only; no automatic fallback from Cakto.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_LIFETIME=
STRIPE_LIFETIME_ENABLED=true

# Must match domain exposure.
FRONTEND_URL=https://airia.pro
API_URL=https://airia.pro
