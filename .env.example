EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Billing (names only; keep real credentials in ignored runtime environments)
APP_URL=https://airia.pro
# Primary provider. Use stripe only as an explicit operational rollback.
BILLING_PROVIDER=cakto
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=
CAKTO_SUBSCRIPTION_PRODUCT_ID=
CAKTO_LIFETIME_PRODUCT_ID=
CAKTO_MONTHLY_OFFER_ID=
CAKTO_ANNUAL_OFFER_ID=
CAKTO_LIFETIME_OFFER_ID=
# Optional overrides; defaults point to Cakto production.
CAKTO_API_BASE_URL=https://api.cakto.com.br
CAKTO_CHECKOUT_BASE_URL=https://pay.cakto.com.br

# Stripe contingency. It is never selected as an automatic fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_LIFETIME=
# Set false to stop new lifetime checkouts without revoking existing purchases.
STRIPE_LIFETIME_ENABLED=true
ADMIN_SECRET=
